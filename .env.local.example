# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# Públicas (seguras de exponer en el navegador) — proyecto copamunecaburromonteria's Project
NEXT_PUBLIC_SUPABASE_URL=https://jnbototdivmesmciubxo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_H0fQfWD9C9AwYdMRlBv7Mw_qfhp2QVe

# Google Analytics 4 — seguimiento de todo el sitio (Fernando, 2026-09-21).
# Se carga en src/app/layout.tsx con @next/third-parties/google. Si queda
# vacío, simplemente no se carga GA (no rompe nada).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C0GH31DSRD

# SECRETA — solo servidor, nunca debe llegar al navegador ni a git.
# Se obtiene en Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — notificaciones por correo (cuenta de Resend de redeshakunna@gmail.com).
# Mientras no haya un dominio propio verificado, el remitente de prueba
# (onboarding@resend.dev) SOLO puede entregar correos a redeshakunna@gmail.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Copa Muñeca e'Burro <noreply@xn--copamuecaburro-vnb.com>"

# Secreto para proteger /api/cron/recordatorios-pago (Vercel Cron lo llama
# con este valor en el header Authorization). Ya generado, no hace falta
# inventarlo — solo se necesita configurar el mismo valor en Vercel.
CRON_SECRET=

# Wompi — checkout en línea de las partidas del plan de pagos (misma cuenta
# de Wompi que Hakunna Fit, ver `analisis-arquitectura-backend.md`). Se
# obtienen en el dashboard de Wompi → Desarrolladores → Integración técnica.
# No se usa webhook (evita tocar la URL de eventos compartida con Hakunna
# Fit) — el pago se confirma consultando la transacción directamente contra
# la API de Wompi, ver `src/lib/wompi/client.ts`.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
# No se usa todavía (queda guardado para si más adelante se agrega un
# webhook como respaldo) — no se necesita para el flujo actual.
WOMPI_EVENTS_SECRET=

# A dónde llega el correo de "pago recibido" con el detalle de quién pagó
# cada partida (equipo, delegado, monto, medio de pago). Se dispara solo en
# pagos automáticos por Wompi, nunca en validación manual desde el admin.
WOMPI_ADMIN_NOTIFICATION_EMAIL=copamunecaburromonteria@gmail.com
